# ------------------------------------------------------------------
# LifeRescue AI — environment variables (TEMPLATE)
# ------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored — never commit real credentials.
#
# MongoDB Atlas connection string (Cluster0).
# Get it from: Atlas → Database → Connect → Drivers → Node.js
# Remember to URL-encode special characters in the password
# (e.g. `@` -> %40, `#` -> %23, `/` -> %2F).
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@cluster0.xxxxx.mongodb.net/liferescue?retryWrites=true&w=majority&appName=Cluster0

# Port the Express API listens on.
PORT=5000

# Allowed browser origin for CORS (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# How long to wait for Atlas to respond before failing (ms).
MONGODB_TIMEOUT_MS=10000

# Optional: DNS resolvers used as a fallback if the system resolver
# cannot answer the SRV lookup required by a mongodb+srv:// URI
# (some Windows setups produce `querySrv ECONNREFUSED`). Comma separated.
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
